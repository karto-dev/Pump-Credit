# Copy to .env.prod on the server and fill in. Never commit .env.prod.
DOMAIN=credit.example.in               # DNS A record -> the instance's Elastic IP (a free DuckDNS name works)

DB_USERNAME=ppcms
DB_PASSWORD=change-me-long-random      # openssl rand -base64 24
JWT_SECRET=change-me-at-least-32-bytes # openssl rand -base64 48

# First admin, created only on an empty database. Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# LOCAL keeps bills/proofs on the instance's EBS volume. S3 needs an IAM role on the instance with
# s3:GetObject/PutObject/DeleteObject on the bucket (no access keys on the box).
STORAGE_TYPE=LOCAL
S3_BUCKET=
AWS_REGION=ap-south-1

# SMS / WhatsApp. LOG = server log only. WEBHOOK = POST {channel,to,text} to your provider/relay.
NOTIFY_PROVIDER=LOG
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
